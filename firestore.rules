rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isDoctor() {
      return isSignedIn() && getUserData(request.auth.uid).role == 'doctor';
    }

    // Validation helpers
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'role', 'name', 'email'])
          && data.id == request.auth.uid
          && data.role in ['patient', 'doctor']
          && (data.role == 'doctor' || data.keys().hasAll(['age', 'gender', 'bloodGroup', 'address']))
          && (data.role == 'patient' || data.keys().hasAll(['degree', 'address']))
          && data.name is string && data.name.size() <= 100
          && data.email is string && data.email.size() <= 100;
    }

    function isValidRecord(data) {
      return data.keys().hasAll(['id', 'patientId', 'fileURL', 'type', 'createdAt'])
          && data.patientId == request.auth.uid
          && data.type in ['prescription', 'report']
          && data.fileURL is string && data.fileURL.size() <= 2000
          && data.createdAt == request.time;
    }

    function isValidReminder(data) {
      return data.keys().hasAll(['id', 'title', 'time', 'completed', 'createdAt'])
          && data.title is string && data.title.size() <= 200
          && data.time is string && data.time.size() <= 100
          && data.completed is bool
          && data.createdAt == request.time;
    }

    match /users/{userId} {
      // Patients and Doctors can see their own profile.
      // Doctors can see a patient profile if sharing is enabled.
      allow get: if isOwner(userId) || (isDoctor() && existing().role == 'patient' && existing().sharingEnabled == true);
      
      allow create: if isOwner(userId) && isValidUser(incoming());
      
      allow update: if isOwner(userId) 
                    && isValidUser(incoming())
                    && incoming().role == existing().role
                    && (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'age', 'gender', 'bloodGroup', 'address', 'degree', 'sharingEnabled']));

      match /reminders/{reminderId} {
        allow read, write: if isOwner(userId);
        allow create: if isOwner(userId) && isValidReminder(incoming());
      }
    }

    match /records/{recordId} {
      // Patients see their own records.
      // Doctors see records of a patient who has enabled sharing.
      allow list: if isSignedIn() && (
        resource.data.patientId == request.auth.uid || 
        (isDoctor() && getUserData(resource.data.patientId).sharingEnabled == true)
      );
      
      allow get: if isSignedIn() && (
        resource.data.patientId == request.auth.uid || 
        (isDoctor() && getUserData(resource.data.patientId).sharingEnabled == true)
      );
      
      allow create: if isSignedIn() && isOwner(incoming().patientId) && isValidRecord(incoming());
      allow delete: if isSignedIn() && isOwner(resource.data.patientId);
    }
  }
}
